{
  "name": "C++ / CMake / PlantUML Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "twxs.cmake",
        "jebbs.plantuml"
      ]
    }
  },
  "settings": {
    "cmake.generator": "Ninja",
    "plantuml.jar": "/usr/share/plantuml/plantuml.jar"
  },
  "remoteUser": "vscode"
}
